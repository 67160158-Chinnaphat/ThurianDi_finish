# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า (ห้าม commit ไฟล์ .env ขึ้น Git)

POSTGRES_USER=myuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mydb

# สร้างค่าใหม่: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string
CORS_ORIGINS=*

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# --- Ollama / หมอนทอง AI ---
# ต้อง ollama pull <โมเดล> ก่อน และให้โมเดลลงการ์ดจอให้ครบ (ตรวจด้วย ollama ps ให้ขึ้น 100% GPU)
OLLAMA_BASE_URL=http://host.docker.internal:11434
# ต้องใช้รุ่น -instruct เท่านั้น (แท็กที่ไม่มีคำต่อท้ายเป็นรุ่น thinking จะคิดจนไม่ตอบ)
OLLAMA_MODEL=qwen3-vl:2b-instruct
# (ไม่บังคับ) โมเดลสำหรับคำถามที่ไม่มีรูป เช่น llama3.2:latest ปล่อยว่าง = ใช้ OLLAMA_MODEL
OLLAMA_TEXT_MODEL=
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=1000
OLLAMA_TIMEOUT=300
